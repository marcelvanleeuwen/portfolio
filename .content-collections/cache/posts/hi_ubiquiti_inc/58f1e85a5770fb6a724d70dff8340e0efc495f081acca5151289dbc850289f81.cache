uch space in a room.\"}),`\n`,(0,t.jsx)(e.p,{children:\"At the moment this is still speculation, but the hints inside the Design Center definitely caught my attention. If a 24U UniFi rack really is coming, I think there will be a lot of interest from the community.\"}),`\n`,(0,t.jsx)(e.p,{children:\"Now we wait\"})]})}function m(n={}){let{wrapper:e}=n.components||{};return e?(0,t.jsx)(e,{...n,children:(0,t.jsx)(c,{...n})}):c(n)}return k(U);})();\n;return Component;"